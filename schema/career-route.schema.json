{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-grounded Career Route Schema 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "subtitle",
    "category",
    "jurisdiction",
    "last_verified",
    "status",
    "summary",
    "target",
    "entry_points",
    "nodes",
    "edges",
    "pathways",
    "requirements",
    "caveats",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "subtitle": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "enum": [
        "military",
        "judicial",
        "government",
        "public-safety",
        "education",
        "healthcare",
        "technology",
        "business",
        "public-service"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "published"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "pathways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathway"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "entry",
            "milestone",
            "role",
            "target"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "label",
        "evidence",
        "note"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "evidence": {
          "enum": [
            "normative",
            "official_description",
            "illustrative",
            "conditional"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 8
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "pathway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "node_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "node_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "published"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "published": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
